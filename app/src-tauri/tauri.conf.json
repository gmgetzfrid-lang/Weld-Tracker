{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weld Tracker",
  "version": "0.1.0",
  "identifier": "com.kernenergy.weldtracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kern Energy Weld Tracker",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Kern Energy",
    "category": "Business",
    "shortDescription": "Weld log, welder roster and NDE reporting",
    "longDescription": "Kern Energy Weld Tracker — weld log, welder roster, pipe reference and NDE/QC reporting converted from the Weld Log Statistics workbook.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
